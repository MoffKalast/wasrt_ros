<?xml version="1.0"?>
<package format="2">
  <name>wasrt_ros</name>
  <version>0.2.0</version>
  <description>Self-contained ROS Noetic node for WaSR-T (ResNet-101) maritime semantic segmentation.</description>
  <maintainer email="vid.rijavec@fri.uni-lj.si">Vid Rijavec</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <!-- python-only: the c++ nodes convert sensor_msgs/Image themselves to keep a single OpenCV in the process -->
  <exec_depend>cv_bridge</exec_depend>
  <depend>tf2_ros</depend>
  <depend>message_filters</depend>
  <depend>eigen</depend>
</package>
