<launch>
  <!-- Path to the downloaded eWaSR ResNet-18 (non-IMU) .pth weights (required). -->
  <arg name="weights" default="~/ewasr_resnet18.pth"/>
  <arg name="camera_topic" default="/camera/image_rect/compressed"/>
  <arg name="image_topic" default="/camera/image_cropped"/>
  <arg name="scan_topic" default="/scan_filtered"/>
  <arg name="scan_out_topic" default="/scan_verified"/>
  <arg name="publish_preview" default="false"/>

  <node name="ewasr_node" pkg="wasrt_ros" type="ewasr_node.py" output="screen">
    <param name="weights" value="$(arg weights)"/>
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="publish_preview" value="$(arg publish_preview)"/>
  </node>

  <node name="ewasr_camera_preprocessor_node" pkg="wasrt_ros" type="camera_preprocessor_node" output="screen">
    <param name="camera_topic" value="$(arg camera_topic)"/>
    <param name="output_topic" value="$(arg image_topic)"/>
    <param name="publish_preview" value="$(arg publish_preview)"/>
    <param name="downsample" value="0.25"/>
    <param name="crop_top" value="0.1"/>
    <param name="crop_bottom" value="0.32"/>
    <param name="divisor" value="32"/>
  </node>

  <node name="ewasr_lidar_verifier_node" pkg="wasrt_ros" type="lidar_verifier_node" output="screen">
    <param name="scan_topic" value="$(arg scan_topic)"/>
    <param name="scan_out_topic" value="$(arg scan_out_topic)"/>
    <param name="camera_info_topic" value="$(arg image_topic)/camera_info"/>
    <param name="publish_preview" value="$(arg publish_preview)"/>
  </node>

  <node name="ewasr_ground_projector_node" pkg="wasrt_ros" type="ground_projector_node" output="screen">
    <param name="camera_info_topic" value="$(arg image_topic)/camera_info"/>
    <param name="target_frame" value="local"/>
    <param name="max_range_obstacles" value="3.0"/>
    <param name="max_range_free" value="10.0"/>
    <param name="h_stride_frac" value="0.025"/>
    <param name="group_cell_size" value="0.2"/>
  </node>

</launch>
